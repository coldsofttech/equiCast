# Copy to .env.local (gitignored) and fill in real values. Vite only
# exposes vars prefixed VITE_ to client code, and bakes them in at build
# time — see src/auth/auth0Config.js and src/api/client.js.

# From registering a Single Page Application in the Auth0 tenant — see
# docs/auth0-setup.md's "Register the frontend Application" section.
# Same values for dev and prod (one shared Auth0 tenant/API).
VITE_AUTH0_DOMAIN=equicast.eu.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.equicast.app

# Only needed for a production build — local dev proxies /api to the
# Django server via vite.config.js and doesn't need this set. Dev and prod
# have different values here (separate backend deployments); see
# CHANGELOG.md for why deploy.yml doesn't set this per-environment yet.
# VITE_API_BASE_URL=https://<api-gateway-id>.execute-api.eu-west-1.amazonaws.com/api
